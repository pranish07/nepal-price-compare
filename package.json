  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "1.2.0",
    "ipaddr.js": "^2.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  }
