{
  "name": "nepal-price-compare",
  "version": "0.1.0",
  "private": true,
  "description": "Compare prices for beauty products across Nepali sellers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsc -p tsconfig.mcp.json && node .mcp-build/mcp/cli.js",
