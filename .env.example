# All variables are optional. The app runs without any keys using its two built-in
# store adapters. Copy this file to .env.local for local development.

# Serper discovery. When unset, Serper is skipped and spends 0 credits.
SERPER_API_KEY=

# Optional durable cache, rate limits, and global daily credit ledger.
# Strongly recommended on serverless, where in-memory state is per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact URL used in the crawler User-Agent.
CRAWLER_CONTACT=https://github.com/nepal-price-compare

# Cache windows.
CACHE_TTL_SECONDS=21600
CACHE_STALE_SECONDS=86400

# Discovery caps. An uncached search spends at most 8 Serper credits.
MAX_SERPER_CREDITS_PER_SEARCH=8
MAX_SERPER_VARIANTS=3
MAX_SERPER_PAGES=2
SERPER_DAILY_CREDIT_CEILING=100
SERPER_TIMEOUT_MS=10000

# HTML fetching caps.
MAX_FETCHES_PER_REQUEST=25
FETCH_TIMEOUT_MS=8000
MAX_BYTES_PER_PAGE=2097152
FETCH_CONCURRENCY=6
PER_DOMAIN_DELAY_MS=500
ADAPTER_TIMEOUT_MS=9000

# Per-IP rate limits.
SEARCH_RATE_LIMIT_PER_HOUR=10
DETECT_RATE_LIMIT_PER_HOUR=30
